{
  "services": {
    "frontend": {
      "root": ".",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/api/unavailable"
        }
      ]
    },
    "backend": {
      "root": "server",
      "entrypoint": "server.js",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}